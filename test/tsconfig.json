{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2020",
    "types": [],
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": [
      "ESNext"
    ],
    "moduleResolution": "bundler"
  }
}